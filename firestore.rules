rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    match /users/{userId} {
      allow read: if isAuth() && (isOwner(userId) || getUserData().role == 'coach');
      allow create: if isAuth() && isOwner(userId);
      allow update: if isAuth() && isOwner(userId);
    }

    match /teams/{teamId} {
      allow read: if isAuth();
      allow create: if isAuth() && getUserData().role == 'coach';
      allow update: if isAuth() && (
        request.auth.uid in resource.data.coachIds ||
        getUserData().role == 'coach'
      );
    }

    match /dailyLogs/{logId} {
      allow read: if isAuth() && (
        resource.data.athleteId == request.auth.uid ||
        (getUserData().role == 'coach' && resource.data.teamId == getUserData().teamId)
      );
      allow create: if isAuth() && request.resource.data.athleteId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.athleteId == request.auth.uid ||
        (getUserData().role == 'coach' && resource.data.teamId == getUserData().teamId)
      );
    }
  }
}
